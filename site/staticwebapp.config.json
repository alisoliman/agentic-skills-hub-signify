{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/hub.json",
      "/*.{css,js,mjs,json,map,txt,xml,ico,png,jpg,jpeg,gif,svg,webp,avif,woff,woff2}",
      "/assets/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Cache-Control": "no-cache"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
